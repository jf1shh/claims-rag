# AutoClaimsRAG foundation configuration
# Copy to .env for local use. Never commit .env or real credentials.

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Local persistence
RAG_DB_PATH=./rag_store.db
STORED_DOCUMENTS_DIR=./stored_documents
OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_BUCKET=

# Retrieval and models
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_PROVIDER=lm-studio
LLM_BASE_URL=http://127.0.0.1:1234
LLM_MODEL=
SIMULATION_MODE=true

# Safety and resource limits
MAX_UPLOAD_BYTES=26214400
MAX_DOCUMENT_CHARS=2000000
MAX_QUERY_CHARS=10000
MAX_TOP_K=50
REQUEST_TIMEOUT_SECONDS=120
