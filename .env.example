# ClaimsRAG foundation configuration
# Export these variables, or use uvicorn --env-file .env. Settings does not auto-load .env.
# Never commit .env or real credentials.

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Local persistence
RAG_DB_PATH=./rag_store.db
STORED_DOCUMENTS_DIR=./stored_documents
JOBS_DB_PATH=./jobs.db
# Durable metadata audit log; chat questions/answers are excluded. Operator retention required.
AUDIT_LOG_PATH=./audit.log.jsonl
OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_BUCKET=

# Object storage (Phase 2): provider "filesystem" (default) or "s3". S3 uses
# the standard AWS credential chain (env vars / shared config / IAM role) and
# points at a real bucket or a compatible endpoint (MinIO/LocalStack via
# S3_ENDPOINT_URL). SSE-KMS is set via S3_SSE_KMS_KEY_ID when required.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_SSE_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Vector store backend (Phase 1): sqlite (default) or postgres (Postgres + pgvector)
VECTOR_STORE=sqlite
POSTGRES_DSN=
TENANT_ID=local-development

# Ingestion queue (Phase 3): "in-process" (default, dev/test loopback) or "sqs".
# SQS uses the standard AWS credential chain; the DLQ receives messages whose
# retries are exhausted. SQS_REGION/SQS_ENDPOINT_URL mirror the S3_* pair.
QUEUE_PROVIDER=in-process
SQS_QUEUE_URL=
SQS_DLQ_URL=
SQS_REGION=us-east-1
SQS_ENDPOINT_URL=

# Ingestion worker (Phase 3): retry/backoff/poll tuning
WORKER_MAX_RETRIES=5
WORKER_BACKOFF_BASE_SECONDS=2
WORKER_POLL_INTERVAL_SECONDS=1

# Ingestion mode (Phase 3.2): "sync" (default, inline upload pipeline) or
# "async" (upload returns 202 + job_id; a worker indexes off the request
# thread and the frontend polls GET /api/jobs/{job_id} for real progress).
# Async mode stages upload bytes in the blob store (S3 adapter, or a local
# ingest_queue dir for the filesystem provider) and starts an in-process
# worker; SQS deployments run the worker as its own process.
INGESTION_MODE=sync

# Retrieval and models
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Phase 5.2: local CPU reranker or dedicated GPU service.
RERANK_PROVIDER=local
RERANK_ENDPOINT=
# Was 50; lowered to 15 per the Phase 6.1 load-test finding -- cuts sequential
# rerank latency (measured: ~365ms -> ~155-167ms live) with no eval-suite-
# verified quality regression (golden-query recall@4 unchanged vs. pool=50).
# A more aggressive pool=8 was tried and reverted: it cut latency further
# (~80ms) but cost real answer-correctness on 2 of 19 eval queries. Does not
# fix concurrent-load latency -- see docs/enterprise-migration.md Phase 6.1.
RERANK_CANDIDATE_POOL=15
RERANK_TIMEOUT_SECONDS=10
RERANK_API_KEY=
# Phase 6.1 concurrent-load fix: bounds how many local CPU rerank calls run at
# once. py-spy profiling + controlled A/B tests (docs/enterprise-migration.md)
# ruled out torch intra-op thread count and multi-process workers -- neither
# changed concurrent p95 at all, meaning the cost scales with the number of
# simultaneous cross-encoder forward passes, not with how each one is
# threaded/processed (consistent with shared CPU memory-bandwidth/cache being
# the real constraint). Queuing instead of racing measurably lowers p95.
RERANK_MAX_CONCURRENCY=2
# auto | cpu | cuda -- "auto" uses a local GPU when torch can see one and falls back
# to CPU otherwise. ROCm builds address AMD cards as "cuda" too.
RERANK_DEVICE=auto
# Phase 6.1 local cross-request micro-batching. The bounded coordinator
# coalesces independent local GPU/CPU rerank calls; set false for an immediate
# rollback to the existing direct semaphore path. These are process-local only.
RERANK_BATCHING_ENABLED=true
RERANK_BATCH_MAX_WAIT_MS=5
RERANK_BATCH_MAX_REQUESTS=16
RERANK_BATCH_MAX_PAIRS=256
RERANK_INFERENCE_BATCH_SIZE=16
RERANK_BATCH_MAX_PENDING=1024
LLM_PROVIDER=lm-studio
LLM_BASE_URL=http://127.0.0.1:1234
LLM_MODEL=
# Phase 5.1: per-stage model catalog against the allowlisted LLM_BASE_URL
# (LM Studio locally; a private vLLM/TGI/SGLang gateway in production).
PLANNING_MODEL=            # fast model for query decomposition (else LLM_MODEL)
SYNTHESIS_MODEL=           # bought/built domain model for the final answer (else LLM_MODEL)
EVAL_MODEL=                # optional judge model (else LLM_MODEL)
LLM_API_KEY=               # Bearer credential from secrets; never in .env
LLM_SYNTHESIS_TIMEOUT_SECONDS=120
LLM_PLAN_TIMEOUT_SECONDS=5
MODEL_CACHE_TTL_SECONDS=10
SIMULATION_MODE=true

# Authentication (Phase 4.1): comma-separated provider chain -- "development"
# (default; explicit local identity for dev/test), "oidc" (Bearer JWT verified
# against the issuer's JWKS), "service-accounts" (X-API-Key from a JSON file).
# Production requires a real provider; "development" is rejected there.
AUTH_PROVIDERS=development
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_JWKS_URL=          # defaults to {OIDC_ISSUER}/.well-known/jwks.json
OIDC_ROLES_CLAIM=roles  # claim holding the role list (Okta often uses "groups")
OIDC_TENANT_CLAIM=tenant_id  # claim holding the tenant id (Entra uses "tid")
OIDC_CACHE_TTL_SECONDS=300
# JSON file mapping API key -> {subject, tenant_id, roles} for service accounts
SERVICE_ACCOUNTS_FILE=

# RBAC claim-level ACLs (Phase 4.2): JSON file mapping claim_id -> [subjects].
# With no file (the dev/test default), claim access is open within the tenant;
# once configured, adjusters see only their assigned claims while admin/
# supervisor/siu see all. Roles and their permissions live in backend/rbac.py.
CLAIM_ACLS_FILE=

# Safety and resource limits
MAX_UPLOAD_BYTES=26214400
# Phase 4.4: per-principal rate limiting on sensitive/costly endpoints
# (chat, eval search, uploads, delete). Requests over the allowance within the
# sliding window are answered 429. In-process limiter; distributed state
# (Redis) is deployment wiring like SQS.
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_DOCUMENT_CHARS=2000000
MAX_QUERY_CHARS=10000
MAX_TOP_K=50
# Hard timeout for the isolated document parser; LLM calls use their own timeouts.
REQUEST_TIMEOUT_SECONDS=120

# Phase 5.3: context assembly caps fed to the model per query.
CONTEXT_MAX_CLAIM_CHUNKS=8
CONTEXT_MAX_GLOBAL_MATCHES=4
CONTEXT_MAX_PROMPT_CHARS=60000

# Post-generation answer guard (docs/adversarial-evaluation.md). withhold | flag | off.
# withhold replaces an answer asserting a claim outcome (approved/paid/denied/referred/closed)
# the claim record does not show, or containing a URL/email outside the allowlist below.
ANSWER_GUARD_MODE=withhold
# Comma-separated domains an answer may link to or cite as a contact (subdomains included).
ANSWER_GUARD_ALLOWED_DOMAINS=

# Evidence conflict check (docs/adversarial-evaluation.md). llm | off. With llm, one short extra
# model call per answer lists each retrieved source's value; differing numbers across sources set
# structured.answer.status to conflicting_evidence. Skipped for withheld/error/simulated answers.
CONFLICT_CHECK=llm

# Prompt-injection defenses (docs/adversarial-evaluation.md, fix 3): comma list of sanitize,
# sandwich, datamark, or none. sanitize neutralises assistant-addressed instruction sentences in
# retrieved text (no measured quality cost); sandwich/datamark lowered attack success further but
# cost ~0.12 factual correctness in the golden eval, so they are opt-in.
PROMPT_DEFENSE=sanitize
