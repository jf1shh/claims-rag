{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "claimsrag-backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "backend.app:app", "--reload", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "claimsrag-eval",
      "runtimeExecutable": "env",
      "runtimeArgs": ["SIMULATION_MODE=false", "HF_HUB_OFFLINE=1", ".venv/bin/python", "-m", "uvicorn", "backend.app:app", "--port", "8000"],
      "port": 8000
    }
  ]
}
